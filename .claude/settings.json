{
  "permissions": {
    "allow": [
      "Bash(flutter analyze*)",
      "Bash(flutter test*)",
      "Bash(flutter build apk*)",
      "Bash(flutter build ios*)",
      "Bash(xcrun swift-format *)",
      "Bash(xcrun swiftc -parse *)",
      "Bash(dart analyze*)",
      "Bash(dart format *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/analyze-changed.sh",
            "timeout": 600,
            "statusMessage": "바뀐 Dart/Kotlin/Swift 파일 검사 중…"
          }
        ]
      }
    ]
  }
}
